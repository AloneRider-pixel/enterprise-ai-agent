# ============================================
# Enterprise AI Agent - Environment Configuration
# ============================================

# Application
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_agent
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=agent_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_SECRET_KEY=your-jwt-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Hallucination Detection
HALLUCINATION_THRESHOLD=0.7

# Cost Tracking
COST_ALERT_THRESHOLD_USD=10.0

# AWS (for deployment)
AWS_REGION=ap-south-1
AWS_ECR_REPOSITORY=enterprise-ai-agent
